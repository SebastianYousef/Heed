<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Heed reads every notification you get, watches which apps you use, and (if you
      enable it) observes scrolling. That is a lot of trust. The thing that makes it
      safe to give is below: this app has no INTERNET permission, so it cannot open a
      socket at all. That is not a promise about what the code does — Android puts a
      process in the inet group only when the permission is granted, so the kernel
      refuses the syscall. There is no code path, bug or dependency that can send your
      data anywhere.

      The removals are explicit rather than merely absent so that a library added later
      cannot quietly reintroduce them through manifest merging. A Gradle task in
      app/build.gradle.kts fails the build if INTERNET ever reappears in the merged
      manifest, so this cannot rot.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
      Must be declared even though it is granted through a special-access settings screen
      rather than a normal permission prompt. Without the declaration the app does not
      appear in Settings > Special app access > Usage access at all, so there is no way to
      grant it — which is exactly the bug this fixes.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Lets Heed enforce app limits, bedtime and grayscale without an accessibility
      service. That matters because banking apps refuse to run while one is enabled, so
      putting every limit behind accessibility forced a choice between your bank and your
      rules. See focus/AttentionService.kt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Optional, and only used to draw the block screen when the accessibility service is
      off. With accessibility on, TYPE_ACCESSIBILITY_OVERLAY does the same job and this is
      never requested.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Grayscale. The display daltonizer is a secure setting, so there is no prompt that can
      grant this — it takes one adb command, shown in the app. Declared so that command has
      something to grant. Heed writes exactly two keys with it, both listed in
      focus/Grayscale.kt, and can read nothing it could not read already.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".HeedApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_heed"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Heed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Heed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The capture path. Sees notifications only AFTER they have been posted, so it
          is only clean for apps the user has silenced first (see OnboardingScreen) —
          those arrive without sound, which is what lets us hold and judge them before
          deciding whether to raise our own alert.

          NotificationAssistantService, which would let us adjust a notification before
          it is ever displayed, is @SystemApi and not on the public SDK classpath. It is
          unavailable to third-party apps regardless of device. See README.
        -->
        <service
            android:name=".capture.HeedListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>


        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!--
          Measures scrolling in order to spot doom scrolling. Declared without
          canRetrieveWindowContent, so Android will not hand it the text on your screen
          under any circumstances — see res/xml/accessibility_service_config.xml.
        -->
        <service
            android:name=".focus.ScrollWatcherService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Enforcement without screen access. Polls usage statistics for the foreground
          app, which is enough for limits, launch counts, bedtime and grayscale.
        -->
        <service
            android:name=".focus.AttentionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces the user's own app time limits and bedtime, which
                    requires knowing which app is in the foreground right now." />
        </service>

        <!-- Today's numbers on the home screen, so the app does not have to be opened
             to be useful. -->
        <receiver
            android:name=".widget.HeedWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heed_widget_info" />
        </receiver>

        <!-- Hands a single export file to the share target the user picks, and nothing
             else. Not exported; access is only ever a per-Intent grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>

*.iml
.gradle/
.kotlin/
local.properties
.idea/
.DS_Store
# Gradle output. Anchored with a negation because an unanchored `build/` also matches a
# Kotlin package directory called `build` — which silently kept the convention plugins,
# including the no-network guard, out of version control for eight commits.
build/
!**/src/**/build/
captures/
.externalNativeBuild
.cxx
*.apk

# Signing keys for release builds. Never committed: anyone holding one can publish an
# update that Android will install over the app without warning. Back them up somewhere
# safe — losing a key means no future release can update an existing install in place,
# and on Accrescent it means the listing cannot be updated at all.
*.jks
keystore.properties
